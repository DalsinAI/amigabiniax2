# Biniax-2 1.30 for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's SDL 1.2
# (sdl12-compat).
#
#   make -f amiga/Makefile.amigaos dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        NDK=/path/to/OpenNDK/Include_H SDLKIT=/path/to/opengpu-sdk \
#        DEPS=/path/to/m68k-amigaos
#
# The makefile's sources (not the network play, desktop/net.c, which it
# leaves out too), with DATADIR the drawer's data/. SDLKIT is the OpenGPU
# developer kit: libSDL.a, sdl12-compat on SDL2.module. It has no SDL_image
# or SDL_mixer 1.2: the Team's amiga/sdl_image_lite.c (PNG on libpng) and
# amiga/sdl_mixer_lite.c (WAV, with libmikmod 3.3.16 for the music:
# amiga/libmikmod, its player, Impulse Tracker loader and no-sound driver),
# from the TecnoballZ port, stand in. DEPS has the Team's static libpng and
# zlib (/mnt/amigachrome/team2/deps/m68k-amigaos).

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
SDLKIT  ?= /mnt/amigachrome/team2/deps/opengpu-sdk
DEPS    ?= /mnt/amigachrome/team2/deps/m68k-amigaos
CC      = $(STOVE)/bin/m68k-amigaos-gcc
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
PROG    = Biniax2
OUT     = dist/Biniax2

DEFS    = -D__amigaos__ -DNDEBUG -DDATADIR=\"PROGDIR:data\"
INC     = -I. -Idesktop -Iamiga/include/SDL -Iamiga/libmikmod -I$(SDLKIT)/include/SDL \
          -I$(DEPS)/include -I$(NDK)
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP -std=gnu99 -w
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDLKIT)/lib -L$(DEPS)/lib -lSDL -lpng -lz -lpthread -lm

SRC     = biniax.c hof.c desktop/cfg.c desktop/gfx.c desktop/snd.c desktop/inp.c desktop/sys.c
CSRC    = amiga/stack.c amiga/sdl_image_lite.c amiga/sdl_mixer_lite.c
MIKMOD_SRC = $(wildcard amiga/libmikmod/*.c)
MIKMOD_CFLAGS = -noixemul -O2 $(CPU) -fno-common -MMD -MP -std=gnu99 -w -DMIKMOD_BUILD \
          -DMIKMOD_STATIC -DHAVE_LIMITS_H -DHAVE_SNPRINTF -DHAVE_UNISTD_H -DWORDS_BIGENDIAN=1 \
          -DNO_DEPACKERS -DNO_HQMIXER -Iamiga/libmikmod -I$(NDK)

OBJS    = $(SRC:%.c=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o) $(MIKMOD_SRC:%.c=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(BUILD)/$(PROG): $(OBJS)
	$(CC) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/amiga/libmikmod/%.o: amiga/libmikmod/%.c
	@mkdir -p $(dir $@)
	$(CC) $(MIKMOD_CFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INC) -DMIKMOD_STATIC -Wall -c -o $@ $<

# -fcommon: the game's headers define its globals (_Inp and others), as
# GCC before 10 allowed by default.
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -fcommon $(DEFS) $(INC) -DMIKMOD_STATIC -c -o $@ $<

# The drawer: the program; data/ (the pictures, sounds, music and texts);
# ReadMe and the licences. The settings, the saved game and the Hall of
# Fame are written in the drawer.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)/data
	cp $(BUILD)/$(PROG) $(OUT)/
	cp -R data/graphics data/music data/sound data/text $(OUT)/data/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp LICENSE.txt $(OUT)/COPYING.txt
	cp amiga/libmikmod/COPYING.LIB $(OUT)/COPYING-libmikmod.txt
	cp amiga/icons/Biniax2.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/COPYING.txt.info
	cp amiga/icons/ReadMe.info $(OUT)/COPYING-libmikmod.txt.info
	cp amiga/icons/Folder.info $(OUT)/data.info
	cp amiga/icons/Biniax2-drawer.info dist/Biniax2.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
